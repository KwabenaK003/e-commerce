{
  "name": "ecommerce",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade e-commerce store for Ghana: Next.js, Supabase, Paystack, Resend, Arkesel",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:db": "vitest run tests/db",
    "test:e2e": "playwright test",
    "create-staff": "tsx scripts/create-staff.ts",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@sentry/nextjs": "^11.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "exceljs": "^3.4.0",
    "fflate": "^0.8.3",
    "framer-motion": "^14.3.0",
    "next": "^16.4.2",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
